# Desactivar la exploración de directorios (evita que se listen los archivos si no hay un index)
Options -Indexes

# ----------------------------------------------------------------------
# Motor de Reescribimiento de URLs (Rewrite engine)
# ----------------------------------------------------------------------

# Activar el motor de reescritura es necesario para las siguientes reglas y funciones.
# Requiere que 'FollowSymLinks' esté habilitado para funcionar.
<IfModule mod_rewrite.c>
  Options +FollowSymlinks
  RewriteEngine On

  # Si instalaste CodeIgniter en una subcarpeta, deberás cambiar la siguiente
  # línea para que coincida con la ruta de tu subcarpeta.
  # http://httpd.apache.org/docs/current/mod/mod_rewrite.html#rewritebase
  # RewriteBase /

  # Eliminar la barra inclinada al final de la URL (Trailing Slash)...
  # Si la petición no es un directorio físico y termina en '/', redirige a la URL sin la '/' final (Redirección 301 permanente)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [L,R=301]

  # Redireccionar "www.ejemplo.com -> ejemplo.com" (fuerza el dominio sin www)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ http://%1%{REQUEST_URI} [R=301,L]

  # Comprueba si el usuario está intentando acceder a un archivo o carpeta real (imágenes, CSS, JS, etc.).
  # Si no existe, envía la petición al controlador frontal (index.php) para que CodeIgniter maneje la ruta.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]

  # Garantizar que el encabezado de Autorización (Authorization Header) se pase correctamente en las peticiones HTTP/API
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule !mod_rewrite.c>
  # Si el módulo mod_rewrite no está instalado en el servidor Apache,
  # redirige todos los errores 404 a index.php para mantener el funcionamiento básico de las rutas.
  ErrorDocument 404 index.php
</IfModule>

# Desactivar la firma del servidor (oculta la versión de Apache/SO por motivos de seguridad)
ServerSignature Off