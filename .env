#--------------------------------------------------------------------
# Archivo de Configuración de Entorno de Ejemplo (.env)
#
# Este archivo sirve como punto de partida para tu propio archivo .env.
# Contiene la mayoría de las opciones disponibles por defecto.
#
# Por defecto, todas las configuraciones están comentadas con '#'.
# Para activar o sobrescribir una opción, quita el '#' al inicio de la línea.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENTORNO (ENVIRONMENT)
# Define el modo de ejecución de la aplicación:
# Options: development, production, testing
#--------------------------------------------------------------------

# Modo de entorno activo (development muestra errores detallados en pantalla)
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APLICACIÓN (APP)
# Configuraciones generales de la app (URL base, seguridad, CSP)
#--------------------------------------------------------------------

# URL principal de la aplicación (ejemplo: http://localhost:8080/ o https://midominio.com/)
# app.baseURL = ''

# Alternativa si tu entorno de servidor tiene problemas procesando puntos en las claves .env
# app_baseURL = ''

# Forzar el uso de HTTPS en todas las peticiones globales de la aplicación (true/false)
# app.forceGlobalSecureRequests = false

# Habilitar o deshabilitar la política de seguridad de contenido (Content Security Policy)
# app.CSPEnabled = false

#--------------------------------------------------------------------
# BASE DE DATOS (DATABASE)
# Parámetros de conexión a la base de datos principal y de pruebas
#--------------------------------------------------------------------

# Base de datos principal (default)
# database.default.hostname = localhost
# database.default.database = ci4
# database.default.username = root
# database.default.password = root
# database.default.DBDriver = MySQLi
# database.default.DBPrefix =
# database.default.port = 3306

# Configuración de base de datos para pruebas automatizadas (tests)
# Si usas MySQLi para tests, actualiza primero los valores en Config\Database::$tests
# database.tests.hostname = localhost
# database.tests.database = ci4_test
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRIPTACIÓN (ENCRYPTION)
# Clave secreta para encriptación de datos y sesiones
#--------------------------------------------------------------------

# Clave de encriptación hexadecimal de 32 bytes (puedes generarla con `php spark key:generate`)
# encryption.key =

#--------------------------------------------------------------------
# SESIÓN (SESSION)
# Configuración del controlador y almacenamiento de sesiones
#--------------------------------------------------------------------

# Manejador de sesiones (FileHandler guarda las sesiones en archivos en el servidor)
# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'

# Ruta personalizada para guardar las sesiones (si es null, usa WRITEPATH . 'session')
# session.savePath = null

#--------------------------------------------------------------------
# REGISTROS DE SISTEMA (LOGGER)
# Nivel de detalle para los logs de error de la aplicación
#--------------------------------------------------------------------

# Umbral de log (1: Errores críticos .. 4: Todos los mensajes incluidos Debug y Info)
# logger.threshold = 4